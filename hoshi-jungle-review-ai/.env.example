# =============================================================================
# Hoshi Jungle Review AI — 環境変数テンプレート
# -----------------------------------------------------------------------------
# ローカル開発:  cp .env.example .env.local  して値を埋める
# Vercel:        Project Settings → Environment Variables に同じキーを登録
#                （NEXT_PUBLIC_ 以外はすべて Server 側のみ。Encrypted で登録すること）
# 注意: .env.local は .gitignore 済み。実値を絶対にコミットしない。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. アプリ基本設定
# -----------------------------------------------------------------------------
# OAuth リダイレクト URI の組み立てに使う。末尾スラッシュなし。
# 例: http://localhost:3000 / https://review.hoshijungle.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 本番/プレビューの区別。Vercel が自動注入する VERCEL_ENV があればそちらを優先。
NODE_ENV=development


# -----------------------------------------------------------------------------
# 2. Supabase (PostgreSQL)
# -----------------------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# service_role キー。RLS をバイパスするため **サーバー側限定**。
# NEXT_PUBLIC_ を絶対に付けない / ブラウザに渡さない。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx

# anon キー。現状のアーキテクチャ（全 DB アクセスがサーバー経由）では未使用。
# 将来クライアント直アクセスを足す場合のみ使う。
# NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# 3. Google OAuth 2.0 / Business Profile API
# -----------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# アプリケーションの種類: 「ウェブ アプリケーション」
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# 承認済みリダイレクト URI。Google Cloud Console 側の登録値と**完全一致**必須。
# ローカルと本番の両方を Console に登録しておく。
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback


# -----------------------------------------------------------------------------
# 4. Claude API (Anthropic) — Suzu が管理
# -----------------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# 返信生成に使うモデル。未設定なら claude-opus-5。
# コストを抑えたい場合の候補: claude-sonnet-5 / claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

# 思考の深さ。low | medium | high | xhigh | max（未設定なら low）
# 返信生成は短文タスクなので low で十分。品質が不足する場合のみ上げる。
ANTHROPIC_EFFORT=low


# -----------------------------------------------------------------------------
# 5. セキュリティ / 暗号鍵
# -----------------------------------------------------------------------------
# Google の refresh_token を DB に保存する際の AES-256-GCM 鍵。
# 生成: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ログインセッション Cookie(JWT) の署名鍵。
# 生成: openssl rand -base64 48
SESSION_SECRET=

# Vercel Cron からの呼び出しを認証する共有シークレット。
# 生成: openssl rand -hex 32
# Vercel Cron は Authorization: Bearer $CRON_SECRET を自動付与する。
CRON_SECRET=


# -----------------------------------------------------------------------------
# 6. 運用ポリシー（機能フラグ）
# -----------------------------------------------------------------------------
# true にすると「自動公開を許可する言語」の返信をレビュー取得直後に自動公開する。
# 初期導入時は必ず false（全件ドラフト）で運用し、品質が安定してから検討する。
AUTO_PUBLISH_ENABLED=false

# 自動公開を許可する言語のカンマ区切り。id（インドネシア語）は制約上ここに入れない。
# AUTO_PUBLISH_ENABLED=false の間はこの値は使われない。
AUTO_PUBLISH_LANGUAGES=

# 自動公開を許可する最低スター評点。3 未満の低評価は常に人間確認に回す。
AUTO_PUBLISH_MIN_RATING=4

# 1 回の同期処理で AI 生成を回す最大件数（API コスト/実行時間の上限）。
MAX_GENERATIONS_PER_RUN=25


# -----------------------------------------------------------------------------
# 7. ホテル固有情報（プロンプトに注入される）
# -----------------------------------------------------------------------------
HOTEL_NAME=Hoshi Jungle
HOTEL_LOCATION=Ubud, Bali, Indonesia
# 返信の署名。空なら「Hoshi Jungle Team」が使われる。
HOTEL_SIGNATURE=Hoshi Jungle Team
# 低評価レビューで案内する連絡先（謝罪文に差し込まれる）。空なら省略される。
HOTEL_CONTACT_EMAIL=
